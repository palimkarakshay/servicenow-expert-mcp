# Copy to ".env" (gitignored) or export in the process that runs the server.
# With none set, the server runs OFFLINE: the live Table API tools return
# {"mode":"offline"} and make NO network call. The knowledge tools always work.
#
# Point at YOUR instance (a free Personal Developer Instance is ideal):
#   developer.servicenow.com → Request Instance → use its URL + admin creds.

SNOW_INSTANCE_URL=https://dev12345.service-now.com
SNOW_USER=admin
SNOW_PASSWORD=your-password
